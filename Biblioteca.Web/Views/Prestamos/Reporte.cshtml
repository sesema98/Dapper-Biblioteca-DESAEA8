@model IEnumerable<PrestamoReporte>
@{ ViewData["Title"] = "Reporte de préstamos"; }
<h1>Reporte de préstamos</h1>
<form method="get" class="row g-3 align-items-end mb-4"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="col-sm-4"><label for="desde" class="form-label">Desde</label><input id="desde" name="desde" type="date" value="@ViewData["Desde"]" class="form-control" /></div><div class="col-sm-4"><label for="hasta" class="form-label">Hasta</label><input id="hasta" name="hasta" type="date" value="@ViewData["Hasta"]" class="form-control" /></div><div class="col-sm-4"><button class="btn btn-primary">Consultar</button></div></form>
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Préstamo</th><th>Socio</th><th>Libros</th><th>Fecha</th><th>Fecha límite</th><th>Estado</th></tr></thead><tbody>@if (!Model.Any()) { <tr><td colspan="6" class="text-center text-muted">No hay préstamos en el rango seleccionado.</td></tr> } @foreach (var item in Model) { <tr><td>@item.PrestamoId</td><td>@item.Socio</td><td>@item.Libros</td><td>@item.FechaPrestamo.ToString("dd/MM/yyyy")</td><td>@item.FechaLimite.ToString("dd/MM/yyyy")</td><td>@item.Estado</td></tr> }</tbody></table></div>
