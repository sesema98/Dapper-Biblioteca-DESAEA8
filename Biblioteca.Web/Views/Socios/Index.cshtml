@model IEnumerable<Socio>
@{ ViewData["Title"] = "Socios"; }

<div class="page-header">
    <div class="page-header-copy">
        <p class="eyebrow">Comunidad</p>
        <h1>Socios</h1>
        <p class="page-description">Consulta las personas habilitadas para solicitar préstamos.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo socio</a>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}

<div class="panel table-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>DNI</th><th>Nombre</th><th>Correo electrónico</th></tr></thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="3" class="empty-state">Todavía no hay socios activos.</td></tr>
                }
                @foreach (var socio in Model)
                {
                    <tr><td class="secondary-cell">@socio.DNI</td><td class="primary-cell">@socio.Nombre</td><td>@socio.Email</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
