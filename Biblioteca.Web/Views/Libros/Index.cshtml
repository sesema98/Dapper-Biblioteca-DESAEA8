@model IEnumerable<Libro>
@{ ViewData["Title"] = "Libros"; }

<div class="page-header">
    <div class="page-header-copy">
        <p class="eyebrow">Catálogo</p>
        <h1>Libros</h1>
        <p class="page-description">Consulta y administra los títulos disponibles en la biblioteca.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo libro</a>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}

<form method="get" class="panel toolbar" role="search">
    <div class="search-field">
        <label for="titulo" class="visually-hidden">Buscar por título</label>
        <input id="titulo" name="titulo" value="@ViewData["TituloBuscado"]" class="form-control" placeholder="Buscar por título..." />
    </div>
    <button class="btn btn-primary" type="submit">Buscar</button>
    @if (!string.IsNullOrWhiteSpace(ViewData["TituloBuscado"]?.ToString()))
    {
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    }
</form>

<div class="panel table-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Título</th><th>ISBN</th><th>Autor</th><th>Ejemplares</th><th class="text-end">Acciones</th></tr></thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="empty-state">No se encontraron libros activos.</td></tr>
                }
                @foreach (var libro in Model)
                {
                    <partial name="_LibroRow" model="libro" />
                }
            </tbody>
        </table>
    </div>
</div>
