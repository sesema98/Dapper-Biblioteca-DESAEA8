@model IEnumerable<Libro>
@{ ViewData["Title"] = "Libros"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Libros</h1><a asp-action="Create" class="btn btn-primary">Nuevo libro</a></div>
@if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }
<form method="get" class="row g-2 mb-3">
    <div class="col-sm-8"><input name="titulo" value="@ViewData["TituloBuscado"]" class="form-control" placeholder="Buscar por título" /></div>
    <div class="col-auto"><button class="btn btn-outline-primary">Buscar</button> <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a></div>
</form>
<div class="table-responsive"><table class="table table-striped table-hover align-middle"><thead><tr><th>Título</th><th>ISBN</th><th>Autor</th><th>Ejemplares</th><th class="text-end">Acciones</th></tr></thead><tbody>
@if (!Model.Any()) { <tr><td colspan="5" class="text-center text-muted">No se encontraron libros activos.</td></tr> }
@foreach (var libro in Model) { <partial name="_LibroRow" model="libro" /> }
</tbody></table></div>
