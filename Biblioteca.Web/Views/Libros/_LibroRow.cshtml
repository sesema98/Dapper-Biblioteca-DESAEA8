@model Libro
<tr>
    <td class="primary-cell">@Model.Titulo</td>
    <td class="secondary-cell">@Model.ISBN</td>
    <td>@Model.AutorNombre</td>
    <td><span class="number-badge">@Model.Ejemplares</span></td>
    <td class="text-end text-nowrap">
        <a asp-action="Details" asp-route-id="@Model.LibroId" class="btn btn-sm btn-outline-secondary">Ver</a>
        <a asp-action="Edit" asp-route-id="@Model.LibroId" class="btn btn-sm btn-outline-primary">Editar</a>
        <a asp-action="Delete" asp-route-id="@Model.LibroId" class="btn btn-sm btn-outline-danger">Eliminar</a>
    </td>
</tr>
