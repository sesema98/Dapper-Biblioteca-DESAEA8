@model Libro
@{ ViewData["Title"] = "Eliminar libro"; }

<div class="page-header">
    <div class="page-header-copy">
        <p class="eyebrow">Catálogo</p>
        <h1>Eliminar libro</h1>
        <p class="page-description">Confirma la eliminación lógica del registro.</p>
    </div>
</div>
<div class="panel danger-panel">
    <div class="alert alert-warning">El libro quedará inactivo, pero su información no se borrará de la base de datos.</div>
    <h2 class="danger-title">@Model.Titulo</h2>
    <p class="danger-copy">@Model.AutorNombre · ISBN @Model.ISBN</p>
    <form asp-action="Delete" asp-route-id="@Model.LibroId" method="post" class="button-row">
        <button class="btn btn-danger" type="submit">Sí, eliminar libro</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</div>
