@model Libro
@{ ViewData["Title"] = "Editar libro"; }

<div class="page-header">
    <div class="page-header-copy">
        <p class="eyebrow">Catálogo</p>
        <h1>Editar libro</h1>
        <p class="page-description">Actualiza la información de <strong>@Model.Titulo</strong>.</p>
    </div>
</div>
<form asp-action="Edit" asp-route-id="@Model.LibroId" method="post" class="panel form-card">
    <input asp-for="LibroId" type="hidden" />
    <partial name="_Form" model="Model" />
    <div class="button-row">
        <button class="btn btn-primary" type="submit">Guardar cambios</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
