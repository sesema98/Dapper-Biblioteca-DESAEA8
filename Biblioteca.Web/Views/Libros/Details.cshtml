@model Libro
@{ ViewData["Title"] = "Detalle del libro"; }
<h1>Detalle del libro</h1><dl class="row form-card"><dt class="col-sm-3">Título</dt><dd class="col-sm-9">@Model.Titulo</dd><dt class="col-sm-3">ISBN</dt><dd class="col-sm-9">@Model.ISBN</dd><dt class="col-sm-3">Autor</dt><dd class="col-sm-9">@Model.AutorNombre</dd><dt class="col-sm-3">Ejemplares</dt><dd class="col-sm-9">@Model.Ejemplares</dd></dl><a asp-action="Edit" asp-route-id="@Model.LibroId" class="btn btn-primary">Editar</a> <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
